@model GerenciadorProjetos.Models.Projeto

@{
    ViewData["Title"] = "Novo Projeto";
}

<h1>Novo Projeto</h1>

<form asp-action="Create" method="post">

    <div>
        <label asp-for="Nome"></label>
        <input asp-for="Nome" />
        <span asp-validation-for="Nome"></span>
    </div>

    <div>
        <label asp-for="Descricao"></label>
        <textarea asp-for="Descricao"></textarea>
        <span asp-validation-for="Descricao"></span>
    </div>

    <div>
        <label asp-for="Responsavel"></label>
        <input asp-for="Responsavel" />
        <span asp-validation-for="Responsavel"></span>
    </div>

    <div>
        <label asp-for="DataInicio"></label>
        <input asp-for="DataInicio" type="date" />
        <span asp-validation-for="DataInicio"></span>
    </div>

    <div>
        <label asp-for="Status"></label>
        <input asp-for="Status" />
        <span asp-validation-for="Status"></span>
    </div>

    <button type="submit">Salvar</button>

</form>

<br />

<a asp-action="Index">Voltar para lista</a>