@model GerenciadorProjetos.Models.Projeto

@{
    ViewData["Title"] = "Detalhes do Projeto";
}

<h1>Detalhes do Projeto</h1>

<div>
    <h4>Projeto</h4>
    <hr />

    <dl>
        <dt>Nome</dt>
        <dd>@Model.Nome</dd>

        <dt>Descrição</dt>
        <dd>@Model.Descricao</dd>

        <dt>Responsável</dt>
        <dd>@Model.Responsavel</dd>

        <dt>Data de Início</dt>
        <dd>@Model.DataInicio.ToString("dd/MM/yyyy")</dd>

        <dt>Status</dt>
        <dd>@Model.Status</dd>
    </dl>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id">Editar</a> |
    <a asp-action="Index">Voltar para lista</a>
</p>