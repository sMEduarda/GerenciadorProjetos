@model GerenciadorProjetos.Models.Funcionario

@{
    ViewData["Title"] = "Novo Funcionário";
}

<h1>Novo Funcionário</h1>

<form asp-action="Create" method="post">

    <div>
        <label asp-for="Nome"></label>
        <input asp-for="Nome" />
        <span asp-validation-for="Nome"></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="Cargo"></label>
        <input asp-for="Cargo" />
        <span asp-validation-for="Cargo"></span>
    </div>

    <div>
        <label asp-for="Departamento"></label>
        <input asp-for="Departamento" />
        <span asp-validation-for="Departamento"></span>
    </div>

    <div>
        <label asp-for="DataAdmissao"></label>
        <input asp-for="DataAdmissao" type="date" />
        <span asp-validation-for="DataAdmissao"></span>
    </div>

    <button type="submit">Salvar</button>

</form>

<br />

<a asp-action="Index">Voltar para lista</a>