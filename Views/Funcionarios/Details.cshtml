@model GerenciadorProjetos.Models.Funcionario

@{
    ViewData["Title"] = "Detalhes do Funcionário";
}

<h1>Detalhes do Funcionário</h1>

<div>
    <hr />

    <dl>
        <dt>Nome</dt>
        <dd>@Model.Nome</dd>

        <dt>Email</dt>
        <dd>@Model.Email</dd>

        <dt>Cargo</dt>
        <dd>@Model.Cargo</dd>

        <dt>Departamento</dt>
        <dd>@Model.Departamento</dd>

        <dt>Data de Admissão</dt>
        <dd>@Model.DataAdmissao.ToString("dd/MM/yyyy")</dd>
    </dl>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id">Editar</a> |
    <a asp-action="Index">Voltar para lista</a>
</p>